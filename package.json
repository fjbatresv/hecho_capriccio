{
  "name": "hecho-capriccio",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "authors": [
    "fjbatresv"
  ],
  "scripts": {
    "lint": "eslint . --ext .js",
    "prettier:check": "prettier --check \"**/*.{js,css,html,json,yml,yaml,md}\"",
    "prettier:write": "prettier --write \"**/*.{js,css,html,json,yml,yaml,md}\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "doc:coverage:report": "node scripts/check-doc-coverage.js --report-only",
    "doc:coverage": "node scripts/check-doc-coverage.js",
    "html-validate": "html-validate index.html",
    "check:links": "node scripts/check-links.mjs",
    "ci": "npm run lint --fix && npm run prettier:check && npm run test:coverage && npm run html-validate && npm run check:links",
    "prepare": "husky install"
  },
  "devDependencies": {
    "doc-coverage": "^1.1.3",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "html-validate": "^10.4.0",
    "husky": "^9.1.3",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "linkinator": "^7.5.1",
    "prettier": "^3.7.4",
    "eslint-config-prettier": "^10.1.8"
  }
}
